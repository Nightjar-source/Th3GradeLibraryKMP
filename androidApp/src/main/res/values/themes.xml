<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background to match our dark theme -->
        <item name="windowSplashScreenBackground">#1E1B4B</item>
        <!-- Set the splash screen icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_icon</item>
        <!-- Set the post-splash theme to follow our light theme configuration -->
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
