<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capability to open specific app features like Library, News, or Bookmarks -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.Nightjar.Th3GradeLibraryKMP"
            android:targetClass="com.Nightjar.Th3GradeLibraryKMP.MainActivity">
            <parameter
                android:name="feature"
                android:key="page"/>
        </intent>
    </capability>

    <!-- Capability to search for specific items (books or notes) -->
    <capability android:name="actions.intent.GET_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.Nightjar.Th3GradeLibraryKMP"
            android:targetClass="com.Nightjar.Th3GradeLibraryKMP.MainActivity">
            <parameter
                android:name="thing.name"
                android:key="search_query"/>
        </intent>
    </capability>
</shortcuts>
