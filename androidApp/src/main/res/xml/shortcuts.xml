<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android App Actions for Google Assistant, Gemini & Bixby -->
    <capability android:name="actions.intent.OPEN_APP_FEATURE">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.Nightjar.Th3GradeLibraryKMP"
            android:targetClass="com.Nightjar.Th3GradeLibraryKMP.MainActivity"
            android:data="th3books://library">
            <parameter
                android:name="feature"
                android:key="page"/>
        </intent>
    </capability>

    <!-- Capability to search for books or notes via Voice Assistant -->
    <capability android:name="actions.intent.GET_THING">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.Nightjar.Th3GradeLibraryKMP"
            android:targetClass="com.Nightjar.Th3GradeLibraryKMP.MainActivity"
            android:data="th3books://library">
            <parameter
                android:name="thing.name"
                android:key="search_query"/>
        </intent>
    </capability>

    <!-- Static App Shortcut: Latest News -->
    <shortcut
        android:shortcutId="shortcut_news"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_news_title"
        android:shortcutLongLabel="@string/shortcut_news_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.Nightjar.Th3GradeLibraryKMP"
            android:targetClass="com.Nightjar.Th3GradeLibraryKMP.MainActivity"
            android:data="th3books://library?page=news" />
    </shortcut>

    <!-- Static App Shortcut: Bookmarks -->
    <shortcut
        android:shortcutId="shortcut_bookmarks"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_bookmarks_title"
        android:shortcutLongLabel="@string/shortcut_bookmarks_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.Nightjar.Th3GradeLibraryKMP"
            android:targetClass="com.Nightjar.Th3GradeLibraryKMP.MainActivity"
            android:data="th3books://library?page=bookmarks" />
    </shortcut>
</shortcuts>
